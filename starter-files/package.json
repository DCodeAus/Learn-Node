    "mongodb": "latest",
    "mongoose": "latest",
    "mongoose-mongodb-errors": "latest",
    "multer": "latest",
    "nodemailer": "latest",
    "passport": "latest",
    "passport-local": "latest",
    "passport-local-mongoose": "latest",
    "pug": "latest",
